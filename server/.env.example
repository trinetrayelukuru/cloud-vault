# Server Configuration
PORT=3001
NODE_ENV=development

# JWT secret: use a unique high-entropy value in production
JWT_SECRET=replace_with_a_unique_64_character_secret
JWT_EXPIRES_IN=24h

# Frontend URL(s) for CORS; comma-separate preview and production origins
CLIENT_URL=http://localhost:5173

# Google OAuth 2.0 credentials (optional until OAuth is enabled)
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:3001/api/auth/google/callback

# Seeded administrator (required in production)
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Vault Administrator
ADMIN_PASSWORD=replace_with_a_unique_12_character_password

# Storage Configuration
# Use 'local' for development, 's3' for production on Vercel
STORAGE_TYPE=local
STORAGE_PATH=./storage
DATABASE_PATH=./database/cloudevault.db

# Production deployment requires S3 storage
# For Vercel production, set STORAGE_TYPE=s3 and provide AWS credentials
# For local development, STORAGE_TYPE=local is fine
S3_BUCKET=your-s3-bucket-name
S3_REGION=us-east-1

# WebAuthn configuration; RP_ID is the frontend hostname without https://
RP_NAME=Cloud Vault
RP_ID=localhost
ORIGIN=http://localhost:5173

# Encryption key: 64 hex characters (32 bytes) in production
VAULT_ENCRYPTION_KEY=replace_with_64_hex_characters

# Rate Limiting
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=100
AUTH_RATE_LIMIT_MAX=5
